<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="At32Debugger.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="StatusIdleBrush" Color="#C0564A" />
            <SolidColorBrush x:Key="StatusOkBrush" Color="#5CB85C" />
            <SolidColorBrush x:Key="StatusBusyBrush" Color="#E8A24A" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8A24A" />

            <!-- 用橙金色替换系统强调色，和手表 UI 的配色一致 -->
            <Color x:Key="SystemAccentColor">#E8A24A</Color>
            <Color x:Key="SystemAccentColorLight1">#F2B76A</Color>
            <Color x:Key="SystemAccentColorLight2">#F7C98C</Color>
            <Color x:Key="SystemAccentColorLight3">#FBDDB8</Color>
            <Color x:Key="SystemAccentColorDark1">#CE8C3A</Color>
            <Color x:Key="SystemAccentColorDark2">#B5772C</Color>
            <Color x:Key="SystemAccentColorDark3">#92601F</Color>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="40" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

